<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Orbinex AI</title>

<style>

* {

  box-sizing: border-box;

}

body {

  margin: 0;

  font-family: Arial, sans-serif;

  background: #10121b;

  color: white;

  height: 100vh;

  overflow: hidden;

}

.app {

  display: flex;

  height: 100vh;

}

/* SIDEBAR */

.sidebar {

  width: 260px;

  background: #171a26;

  padding: 20px;

  display: flex;

  flex-direction: column;

  border-right: 1px solid #292d3d;

}

.logo {

  font-size: 25px;

  font-weight: bold;

  color: #a78bfa;

  margin-bottom: 30px;

}

.new-chat {

  background: #7658df;

  color: white;

  border: none;

  padding: 14px;

  border-radius: 10px;

  cursor: pointer;

  font-size: 15px;

}

.history-title {

  color: #9296a9;

  margin-top: 30px;

  font-size: 13px;

}

.history {

  overflow-y: auto;

  margin-top: 10px;

  flex: 1;

}

.history-item {

  padding: 12px;

  border-radius: 8px;

  cursor: pointer;

  font-size: 14px;

  color: #ddd;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;

}

.history-item:hover {

  background: #292d40;

}

.sidebar-footer {

  color: #85899c;

  font-size: 12px;

  padding-top: 15px;

}

/* MAIN */

.main {

  flex: 1;

  display: flex;

  flex-direction: column;

  min-width: 0;

}

.topbar {

  height: 65px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 0 22px;

  border-bottom: 1px solid #292d3d;

}

.topbar-title {

  font-weight: bold;

}

.status {

  color: #8e9aaa;

  font-size: 12px;

}

.messages {

  flex: 1;

  overflow-y: auto;

  padding: 25px;

  display: flex;

  flex-direction: column;

  gap: 20px;

}

.welcome {

  text-align: center;

  margin: auto;

  padding: 20px;

}

.welcome h1 {

  font-size: 36px;

  background: linear-gradient(90deg, #a78bfa, #60a5fa);

  background-clip: text;

  color: transparent;

}

.welcome p {

  color: #9ca3af;

}

.message {

  max-width: 750px;

  width: fit-content;

  padding: 15px 18px;

  border-radius: 14px;

  line-height: 1.6;

  white-space: pre-wrap;

  overflow-wrap: anywhere;

}

.user {

  background: #5141a6;

  align-self: flex-end;

}

.bot {

  background: #222638;

  align-self: flex-start;

}

/* INPUT */

.input-area {

  padding: 18px;

  border-top: 1px solid #292d3d;

}

.input-box {

  max-width: 850px;

  margin: auto;

  display: flex;

  gap: 10px;

  background: #202436;

  border: 1px solid #373c50;

  padding: 10px;

  border-radius: 15px;

}

.input-box input {

  flex: 1;

  min-width: 0;

  background: transparent;

  border: none;

  outline: none;

  color: white;

  font-size: 16px;

  padding: 10px;

}

.send {

  background: #7658df;

  border: none;

  border-radius: 10px;

  color: white;

  padding: 12px 18px;

  cursor: pointer;

}

.send:disabled {

  opacity: .5;

}

.menu-button {

  display: none;

  background: transparent;

  border: none;

  color: white;

  font-size: 22px;

  cursor: pointer;

}

@media(max-width: 650px) {

  .sidebar {

    position: fixed;

    z-index: 5;

    top: 0;

    bottom: 0;

    left: -270px;

    transition: left .2s;

  }

  .sidebar.open {

    left: 0;

  }

  .menu-button {

    display: block;

  }

  .messages {

    padding: 15px;

  }

  .welcome h1 {

    font-size: 29px;

  }

  .input-area {

    padding: 12px;

  }

}

</style>

</head>

<body>

<div class="app">

  <aside class="sidebar" id="sidebar">

    <div class="logo">✦ Orbinex AI</div>

    <button class="new-chat" onclick="newChat()">

      + New Chat

    </button>

    <div class="history-title">YOUR CONVERSATIONS</div>

    <div class="history" id="history"></div>

    <div class="sidebar-footer">

      Orbinex AI · Your personal AI assistant

    </div>

  </aside>

  <main class="main">

    <header class="topbar">

      <div style="display:flex;align-items:center;gap:12px">

        <button class="menu-button" onclick="toggleMenu()">☰</button>

        <span class="topbar-title">Orbinex AI</span>

      </div>

      <span class="status">AI Assistant</span>

    </header>

    <section class="messages" id="messages">

      <div class="welcome" id="welcome">

        <h1>Welcome to Orbinex AI</h1>

        <p>Your ideas. Your questions. Your AI assistant.</p>

      </div>

    </section>

    <footer class="input-area">

      <form class="input-box" id="chatForm">

        <input

          id="prompt"

          type="text"

          placeholder="Ask Orbinex anything..."

          autocomplete="off"

          required

        >

        <button class="send" id="sendButton" type="submit">

          Send

        </button>

      </form>

    </footer>

  </main>

</div>

<script>

// Add your Cloudflare Worker URL here later.

// Example: https://your-worker.workers.dev

const API_URL = "";

let conversations = JSON.parse(

  localStorage.getItem("orbinex_chats") || "[]"

);

let currentChat = null;

let waiting = false;

const messages = document.getElementById("messages");

const input = document.getElementById("prompt");

const form = document.getElementById("chatForm");

const history = document.getElementById("history");

function saveChats() {

  localStorage.setItem(

    "orbinex_chats",

    JSON.stringify(conversations)

  );

}

function newChat() {

  currentChat = {

    id: Date.now(),

    title: "New conversation",

    messages: []

  };

  conversations.unshift(currentChat);

  saveChats();

  renderChat();

  renderHistory();

  document.getElementById("sidebar").classList.remove("open");

}

function renderChat() {

  messages.innerHTML = "";

  if (!currentChat || currentChat.messages.length === 0) {

    messages.innerHTML = `

      <div class="welcome" id="welcome">

        <h1>Welcome to Orbinex AI</h1>

        <p>Your ideas. Your questions. Your AI assistant.</p>

      </div>

    `;

    return;

  }

  currentChat.messages.forEach(msg => {

    addMessage(msg.text, msg.role);

  });

}

function addMessage(text, role) {

  const bubble = document.createElement("div");

  bubble.className = "message " + role;

  bubble.textContent = text;

  messages.appendChild(bubble);

  messages.scrollTop = messages.scrollHeight;

  return bubble;

}

function renderHistory() {

  history.innerHTML = "";

  conversations.forEach(chat => {

    const item = document.createElement("div");

    item.className = "history-item";

    item.textContent = chat.title;

    item.onclick = () => {

      currentChat = chat;

      renderChat();

      renderHistory();

      document.getElementById("sidebar").classList.remove("open");

    };

    history.appendChild(item);

  });

}

async function sendMessage(event) {

  event.preventDefault();

  const question = input.value.trim();

  if (!question || waiting) return;

  if (!currentChat) {

    newChat();

  }

  waiting = true;

  currentChat.messages.push({

    role: "user",

    text: question

  });

  if (currentChat.title === "New conversation") {

    currentChat.title = question.slice(0, 35);

  }

  input.value = "";

  renderChat();

  renderHistory();

  saveChats();

  const typing = addMessage(

    "Orbinex AI is thinking...",

    "bot"

  );

  document.getElementById("sendButton").disabled = true;

  try {

    const endpoint = API_URL || "/api/chat";

    const response = await fetch(endpoint, {

      method: "POST",

      headers: {

        "Content-Type": "application/json"

      },

      body: JSON.stringify({

        message: question

      })

    });

    const data = await response.json();

    if (!response.ok) {

      throw new Error(data.error || "AI connection failed.");

    }

    if (!data.reply) {

      throw new Error("The AI returned an empty response.");

    }

    typing.textContent = data.reply;

    currentChat.messages.push({

      role: "bot",

      text: data.reply

    });

    saveChats();

  } catch (error) {

    typing.textContent =

      "I couldn't connect to the AI yet. Please check your AI backend connection.";

    console.error(error);

  } finally {

    waiting = false;

    document.getElementById("sendButton").disabled = false;

    input.focus();

    messages.scrollTop = messages.scrollHeight;

  }

}

function toggleMenu() {

  document.getElementById("sidebar").classList.toggle("open");

}

form.addEventListener("submit", sendMessage);

renderHistory();

</script>

</body>

</html>