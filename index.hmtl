
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orbinex AI</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #10121a;
  color: white;
  height: 100vh;
  display: flex;
}
.sidebar {
  width: 245px;
  background: #171a25;
  padding: 20px;
}
.logo {
  font-size: 24px;
  font-weight: bold;
  color: #9988ff;
  margin-bottom: 25px;
}
button {
  cursor: pointer;
  border: none;
  border-radius: 10px;
  padding: 13px;
  color: white;
  background: #7564e8;
}
.new-chat {
  width: 100%;
  background: #292d40;
}
#historyList { margin-top: 20px; }
.history-item {
  padding: 12px;
  margin: 6px 0;
  background: #222637;
  border-radius: 8px;
  cursor: pointer;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.header {
  padding: 20px;
  border-bottom: 1px solid #292d3a;
  font-size: 20px;
  font-weight: bold;
}
.status {
  font-size: 12px;
  color: #68dba1;
  margin-top: 5px;
}
#messages {
  flex: 1;
  overflow-y: auto;
  padding: 25px;
  display: flex;
  flex-direction: column;
  gap: 15px;
}
.welcome {
  text-align: center;
  margin: auto;
  max-width: 500px;
}
.welcome h1 { color: #9988ff; }
.welcome p { color: #aaa; line-height: 1.6; }
.message {
  max-width: 750px;
  padding: 15px;
  border-radius: 14px;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.user {
  background: #5547a8;
  align-self: flex-end;
}
.assistant {
  background: #222637;
  align-self: flex-start;
}
.input-area {
  display: flex;
  gap: 10px;
  padding: 20px;
  border-top: 1px solid #292d3a;
}
#messageInput {
  flex: 1;
  min-width: 0;
  background: #222637;
  border: 1px solid #414761;
  color: white;
  padding: 15px;
  border-radius: 12px;
  font-size: 15px;
}
#sendButton:disabled { opacity: .5; }
@media(max-width:650px) {
  .sidebar { width: 85px; padding: 10px; }
  .logo { font-size: 12px; }
  .history-item { display: none; }
  .new-chat { font-size: 11px; padding: 10px 3px; }
  #messages { padding: 15px; }
}
</style>
</head>
<body>

<aside class="sidebar">
  <div class="logo">ORBINEX AI</div>
  <button class="new-chat" onclick="newChat()">+ New Chat</button>
  <div style="color:#999;margin-top:25px;font-size:13px">YOUR CHATS</div>
  <div id="historyList"></div>
</aside>

<main class="main">
  <header class="header">
    Orbinex AI
    <div class="status">● AI Assistant</div>
  </header>

  <section id="messages">
    <div class="welcome">
      <h1>Welcome to Orbinex</h1>
      <p>Your AI assistant for gaming, technology,
      creativity, questions, and much more.</p>
      <p>What would you like to talk about?</p>
    </div>
  </section>

  <div class="input-area">
    <input id="messageInput" placeholder="Message Orbinex...">
    <button id="sendButton" onclick="sendMessage()">Send</button>
  </div>
</main>

<script>
const API_URL =
  "https://old-leaf-f8d3.zmbiehnter32255.workers.dev";

let chats = JSON.parse(
  localStorage.getItem("orbinex_chats") || "[]"
);
let currentChat = null;

function saveChats() {
  localStorage.setItem("orbinex_chats", JSON.stringify(chats));
}

function newChat() {
  currentChat = {
    id: Date.now(),
    title: "New Chat",
    messages: []
  };
  chats.unshift(currentChat);
  saveChats();
  renderMessages();
  renderHistory();
}

function renderMessages() {
  const area = document.getElementById("messages");
  area.innerHTML = "";

  if (!currentChat || currentChat.messages.length === 0) {
    area.innerHTML = `
      <div class="welcome">
        <h1>Welcome to Orbinex</h1>
        <p>Your AI assistant for questions, gaming,
        technology, and creativity.</p>
      </div>`;
    return;
  }

  currentChat.messages.forEach(msg => {
    const div = document.createElement("div");
    div.className = "message " +
      (msg.role === "user" ? "user" : "assistant");
    div.textContent = msg.content;
    area.appendChild(div);
  });

  area.scrollTop = area.scrollHeight;
}

function renderHistory() {
  const list = document.getElementById("historyList");
  list.innerHTML = "";

  chats.forEach(chat => {
    const item = document.createElement("div");
    item.className = "history-item";
    item.textContent = chat.title;
    item.onclick = () => {
      currentChat = chat;
      renderMessages();
    };
    list.appendChild(item);
  });
}

async function sendMessage() {
  const input = document.getElementById("messageInput");
  const button = document.getElementById("sendButton");
  const message = input.value.trim();

  if (!message || button.disabled) return;

  if (!currentChat) newChat();

  const history = currentChat.messages.slice(-12);

  currentChat.messages.push({
    role: "user",
    content: message
  });

  if (currentChat.messages.length === 1) {
    currentChat.title = message.slice(0, 35);
  }

  input.value = "";
  button.disabled = true;

  const waiting = {
    role: "assistant",
    content: "Orbinex is thinking..."
  };

  currentChat.messages.push(waiting);
  renderMessages();

  try {
    const response = await fetch(API_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        message: message,
        history: history
      })
    });

    const data = await response.json();

    if (!response.ok || data.error) {
      throw new Error(data.error || "Connection failed");
    }

    waiting.content = data.reply || "No answer received.";

  } catch (error) {
    console.error(error);
    waiting.content =
      "Orbinex couldn't connect. Please check the Cloudflare Worker.";
  }

  saveChats();
  renderMessages();
  renderHistory();
  button.disabled = false;
  input.focus();
}

document.getElementById("messageInput")
  .addEventListener("keydown", event => {
    if (event.key === "Enter") sendMessage();
  });

renderHistory();
renderMessages();
</script>
</body>
</html>
