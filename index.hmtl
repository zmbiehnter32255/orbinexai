
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orbinex AI</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #10121b;
  color: white;
}

.app {
  display: flex;
  height: 100dvh;
}

.sidebar {
  width: 260px;
  background: #171a26;
  padding: 20px;
  display: flex;
  flex-direction: column;
  border-right: 1px solid #292d3d;
}

.logo {
  font-size: 25px;
  font-weight: bold;
  color: #a78bfa;
  margin-bottom: 30px;
}

button {
  cursor: pointer;
}

.new-chat, .send {
  background: #7658df;
  color: white;
  border: none;
  padding: 14px;
  border-radius: 10px;
}

.history-title {
  color: #9296a9;
  margin-top: 30px;
  font-size: 13px;
}

.history {
  overflow-y: auto;
  flex: 1;
  margin-top: 10px;
}

.history-item {
  padding: 12px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
  color: #ddd;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-item:hover {
  background: #292d40;
}

.sidebar-footer {
  color: #85899c;
  font-size: 12px;
  padding-top: 15px;
}

.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.topbar {
  height: 65px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 22px;
  border-bottom: 1px solid #292d3d;
}

.status {
  color: #8e9aaa;
  font-size: 12px;
}

.messages {
  flex: 1;
  overflow-y: auto;
  padding: 25px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.welcome {
  text-align: center;
  margin: auto;
  padding: 20px;
}

.welcome h1 {
  font-size: 36px;
  background: linear-gradient(90deg, #a78bfa, #60a5fa);
  background-clip: text;
  color: transparent;
}

.welcome p {
  color: #9ca3af;
}

.message {
  max-width: 750px;
  width: fit-content;
  padding: 15px 18px;
  border-radius: 14px;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.user {
  background: #5141a6;
  align-self: flex-end;
}

.bot {
  background: #222638;
  align-self: flex-start;
}

.input-area {
  padding: 18px;
  border-top: 1px solid #292d3d;
}

.input-box {
  max-width: 850px;
  margin: auto;
  display: flex;
  gap: 10px;
  background: #202436;
  border: 1px solid #373c50;
  padding: 10px;
  border-radius: 15px;
}

.input-box input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: none;
  outline: none;
  color: white;
  font-size: 16px;
  padding: 10px;
}

.menu-button {
  display: none;
  background: transparent;
  border: none;
  color: white;
  font-size: 22px;
}

@media(max-width:650px) {
  .sidebar {
    position: fixed;
    z-index: 5;
    top: 0;
    bottom: 0;
    left: -270px;
    transition: left .2s;
  }

  .sidebar.open {
    left: 0;
  }

  .menu-button {
    display: block;
  }

  .messages {
    padding: 15px;
  }

  .welcome h1 {
    font-size: 29px;
  }
}
</style>
</head>

<body>

<div class="app">

<aside class="sidebar" id="sidebar">
  <div class="logo">✦ Orbinex AI</div>

  <button class="new-chat" onclick="newChat()">
    + New Chat
  </button>

  <div class="history-title">YOUR CHATS</div>
  <div class="history" id="history"></div>

  <div class="sidebar-footer">
    Orbinex AI · Your personal AI assistant
  </div>
</aside>

<main class="main">

  <header class="topbar">
    <div style="display:flex;align-items:center;gap:12px">
      <button class="menu-button" onclick="toggleMenu()">☰</button>
      <strong>Orbinex AI</strong>
    </div>
    <span class="status">AI Assistant</span>
  </header>

  <section class="messages" id="messages">
    <div class="welcome" id="welcome">
      <h1>Welcome to Orbinex AI</h1>
      <p>Your ideas. Your questions. Your AI assistant.</p>
    </div>
  </section>

  <footer class="input-area">
    <form class="input-box" id="chatForm">
      <input
        id="prompt"
        placeholder="Ask Orbinex anything..."
        autocomplete="off"
        required
      >
      <button class="send" id="sendButton">Send</button>
    </form>
  </footer>

</main>
</div>

<script>
const API_URL = "/api/chat";

let chats = JSON.parse(
  localStorage.getItem("orbinex_chats") || "[]"
);

let currentChat = null;
let waiting = false;

const messages = document.getElementById("messages");
const input = document.getElementById("prompt");
const history = document.getElementById("history");

function save() {
  localStorage.setItem(
    "orbinex_chats",
    JSON.stringify(chats)
  );
}

function newChat() {
  currentChat = {
    id: Date.now(),
    title: "New conversation",
    messages: []
  };

  chats.unshift(currentChat);
  save();
  renderChat();
  renderHistory();

  document.getElementById("sidebar").classList.remove("open");
}

function addMessage(text, role) {
  const bubble = document.createElement("div");
  bubble.className = "message " + role;
  bubble.textContent = text;
  messages.appendChild(bubble);
  messages.scrollTop = messages.scrollHeight;
  return bubble;
}

function renderChat() {
  messages.innerHTML = "";

  if (!currentChat || !currentChat.messages.length) {
    messages.innerHTML = `
      <div class="welcome">
        <h1>Welcome to Orbinex AI</h1>
        <p>Your ideas. Your questions. Your AI assistant.</p>
      </div>`;
    return;
  }

  currentChat.messages.forEach(msg => {
    addMessage(msg.text, msg.role);
  });
}

function renderHistory() {
  history.innerHTML = "";

  chats.forEach(chat => {
    const item = document.createElement("div");
    item.className = "history-item";
    item.textContent = chat.title;

    item.onclick = () => {
      currentChat = chat;
      renderChat();
      document.getElementById("sidebar").classList.remove("open");
    };

    history.appendChild(item);
  });
}

async function sendMessage(event) {
  event.preventDefault();

  const question = input.value.trim();
  if (!question || waiting) return;

  if (!currentChat) newChat();

  waiting = true;

  currentChat.messages.push({
    role: "user",
    text: question
  });

  if (currentChat.title === "New conversation") {
    currentChat.title = question.slice(0, 35);
  }

  input.value = "";
  renderChat();
  renderHistory();
  save();

  const typing = addMessage(
    "Orbinex AI is thinking...",
    "bot"
  );

  document.getElementById("sendButton").disabled = true;

  try {
    const response = await fetch(API_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        message: question
      })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || "AI connection failed");
    }

    typing.textContent = data.reply;

    currentChat.messages.push({
      role: "bot",
      text: data.reply
    });

    save();

  } catch (error) {
    typing.textContent =
      "Orbinex AI is not connected yet. Please try again later.";
  }

  waiting = false;
  document.getElementById("sendButton").disabled = false;
  input.focus();
}

function toggleMenu() {
  document.getElementById("sidebar").classList.toggle("open");
}

document.getElementById("chatForm")
  .addEventListener("submit", sendMessage);

renderHistory();
</script>

</body>
</html>
