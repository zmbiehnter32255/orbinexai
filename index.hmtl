
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orbinex AI</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #10121a;
  color: white;
  height: 100vh;
  display: flex;
}

.sidebar {
  width: 250px;
  background: #171a25;
  padding: 20px;
  display: flex;
  flex-direction: column;
}

.logo {
  font-size: 25px;
  font-weight: bold;
  color: #8b7cff;
  margin-bottom: 25px;
}

.new-chat {
  background: #292d40;
  border: 1px solid #414761;
  color: white;
  padding: 13px;
  border-radius: 10px;
  cursor: pointer;
  font-size: 15px;
}

.new-chat:hover {
  background: #383e57;
}

.history-title {
  color: #999;
  margin-top: 30px;
  font-size: 13px;
}

#historyList {
  overflow-y: auto;
}

.history-item {
  padding: 11px;
  margin-top: 7px;
  background: #222637;
  border-radius: 8px;
  cursor: pointer;
  font-size: 13px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-item:hover {
  background: #343a52;
}

.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.header {
  padding: 20px;
  border-bottom: 1px solid #292d3a;
  font-size: 18px;
  font-weight: bold;
}

.status {
  color: #68dba1;
  font-size: 12px;
  margin-top: 5px;
}

#messages {
  flex: 1;
  overflow-y: auto;
  padding: 25px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.welcome {
  text-align: center;
  margin: auto;
  max-width: 500px;
}

.welcome h1 {
  font-size: 38px;
  color: #9a8cff;
}

.welcome p {
  color: #aaa;
  line-height: 1.6;
}

.message {
  max-width: 750px;
  padding: 15px 18px;
  border-radius: 14px;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.user {
  background: #5547a8;
  align-self: flex-end;
}

.assistant {
  background: #222637;
  align-self: flex-start;
}

.input-area {
  padding: 20px;
  border-top: 1px solid #292d3a;
  display: flex;
  gap: 10px;
}

#messageInput {
  flex: 1;
  min-width: 0;
  background: #222637;
  border: 1px solid #414761;
  color: white;
  padding: 16px;
  border-radius: 12px;
  outline: none;
  font-size: 15px;
}

#sendButton {
  background: #7564e8;
  color: white;
  border: none;
  padding: 0 23px;
  border-radius: 12px;
  cursor: pointer;
  font-size: 15px;
}

#sendButton:disabled {
  opacity: 0.5;
  cursor: wait;
}

#sendButton:hover {
  background: #8b7cff;
}

@media (max-width: 650px) {
  .sidebar {
    width: 75px;
    padding: 12px 8px;
  }

  .logo {
    font-size: 12px;
    text-align: center;
  }

  .new-chat {
    font-size: 11px;
    padding: 10px 3px;
  }

  .history-title,
  .history-item {
    display: none;
  }

  #messages {
    padding: 15px;
  }

  .welcome h1 {
    font-size: 28px;
  }
}
</style>
</head>

<body>

<aside class="sidebar">
  <div class="logo">ORBINEX AI</div>

  <button class="new-chat" onclick="newChat()">
    + New Chat
  </button>

  <div class="history-title">YOUR CHATS</div>
  <div id="historyList"></div>
</aside>

<main class="main">

  <header class="header">
    Orbinex AI
    <div class="status">● AI Assistant</div>
  </header>

  <section id="messages">
    <div class="welcome" id="welcome">
      <h1>Welcome to Orbinex</h1>
      <p>Your AI assistant for questions, gaming,
      technology, creativity, and much more.</p>
      <p>What would you like to talk about?</p>
    </div>
  </section>

  <div class="input-area">
    <input
      id="messageInput"
      placeholder="Message Orbinex..."
      autocomplete="off"
    >
    <button id="sendButton" onclick="sendMessage()">
      Send
    </button>
  </div>

</main>

<script>

// REPLACE THIS WITH YOUR CLOUDFLARE WORKER URL
const API_URL = "PASTE_YOUR_WORKER_URL_HERE";

let chats = JSON.parse(
  localStorage.getItem("orbinex_chats") || "[]"
);

let currentChat = null;

function saveChats() {
  localStorage.setItem(
    "orbinex_chats",
    JSON.stringify(chats)
  );
}

function newChat() {
  currentChat = {
    id: Date.now(),
    title: "New Chat",
    messages: []
  };

  chats.unshift(currentChat);
  saveChats();
  renderMessages();
  renderHistory();
}

function renderMessages() {
  const area = document.getElementById("messages");
  area.innerHTML = "";

  if (!currentChat || currentChat.messages.length === 0) {
    area.innerHTML = `
      <div class="welcome">
        <h1>Welcome to Orbinex</h1>
        <p>Your AI assistant for questions, gaming,
        technology, creativity, and much more.</p>
        <p>What would you like to talk about?</p>
      </div>
    `;
    return;
  }

  currentChat.messages.forEach(msg => {
    const div = document.createElement("div");
    div.className = "message " +
      (msg.role === "user" ? "user" : "assistant");
    div.textContent = msg.content;
    area.appendChild(div);
  });

  area.scrollTop = area.scrollHeight;
}

function renderHistory() {
  const list = document.getElementById("historyList");
  list.innerHTML = "";

  chats.forEach(chat => {
    const item = document.createElement("div");
    item.className = "history-item";
    item.textContent = chat.title;

    item.onclick = () => {
      currentChat = chat;
      renderMessages();
    };

    list.appendChild(item);
  });
}

async function sendMessage() {
  const input = document.getElementById("messageInput");
  const button = document.getElementById("sendButton");

  const message = input.value.trim();

  if (!message || button.disabled) return;

  if (API_URL === "PASTE_YOUR_WORKER_URL_HERE") {
    alert("Add your Cloudflare Worker URL first!");
    return;
  }

  if (!currentChat) newChat();

  const previousHistory = currentChat.messages.slice(-12);

  currentChat.messages.push({
    role: "user",
    content: message
  });

  if (currentChat.messages.length === 1) {
    currentChat.title = message.slice(0, 35);
  }

  input.value = "";
  button.disabled = true;

  renderMessages();

  const waiting = {
    role: "assistant",
    content: "Orbinex is thinking..."
  };

  currentChat.messages.push(waiting);
  renderMessages();

  try {
    const response = await fetch(API_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        message: message,
        history: previousHistory
      })
    });

    const data = await response.json();

    if (!response.ok || data.error) {
      throw new Error(data.error || "Connection failed.");
    }

    waiting.content = data.reply || "I didn't receive a reply.";

  } catch (error) {
    waiting.content = "Sorry! Orbinex couldn't connect. Please check the Worker URL and try again.";
    console.error(error);
  }

  saveChats();
  renderMessages();
  renderHistory();
  button.disabled = false;
  input.focus();
}

document.getElementById("messageInput")
  .addEventListener("keydown", event => {
    if (event.key === "Enter") {
      sendMessage();
    }
  });

renderHistory();
renderMessages();

</script>

</body>
</html>
